---
import Layout from "@layouts/Layout.astro";
import { SITE } from "@consts";
---

<Layout title={SITE.TITLE} description={SITE.DESCRIPTION}>
  {/*
    The bio. Everything is soft grey except what's wrapped in <b> or
    is a link, which renders in ink — so the black words alone should
    still read as a summary.
  */}
  <p class="statement">
    I am currently an <b>Undergraduate Research Fellow</b> working on
    <b>streaming algorithms</b> with <a href="https://sepehr.assadi.info/"
      >Sepehr Assadi</a
    > at the <b>University of Waterloo</b>. I am also a <b
      >third year CS student</b
    > at UWaterloo. In the fall of ’25 and summer of ’26, I interned at <a
      href="https://www.axiom.xyz/">Axiom</a
    > where I worked on some <b>ambitious engineering projects</b> for their
    <b>zero-knowledge virtual machine</b>. I am also an <b>IOI medalist</b>.
  </p>
</Layout>
