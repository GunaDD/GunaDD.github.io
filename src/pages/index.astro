---
import Layout from "@layouts/Layout.astro";
import { SITE, SOCIALS } from "@consts";
---

<Layout title={SITE.TITLE} description={SITE.DESCRIPTION}>
  <h1>{SITE.TITLE}</h1>

  {/* EDIT ME — what you're doing right now, in one sentence. */}
  <p>
    I'm a third year Computer Science student at University of Waterloo.
  </p>

  {/* EDIT ME — everything before that, as one list. */}
  <p>
    I am working at <a href="https://www.axiom.xyz/">Axiom</a>, an early-stage
    applied cryptography startup building high-performance infrastructure for
    zero-knowledge proofs. I also do theoretical computer science research in
    streaming algorithms and lower bounds. Before that, I did competitive
    programming where I won a medal at the <a
      href="https://stats.ioinformatics.org/people/8328"
      >International Olympiad in Informatics</a
    >.
  </p>

  {/*
    Kept on one line on purpose: Astro emits a text node for each newline
    inside the map, which shows up as a space before every comma.
  */}
  <p>
    Connect with me on {SOCIALS.map((social, i) => (<Fragment>{i > 0 && ", "}<a href={social.HREF}>{social.NAME}</a></Fragment>))}, or my email at {SITE.EMAIL}!
  </p>
</Layout>
